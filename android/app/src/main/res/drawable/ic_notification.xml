<?xml version="1.0" encoding="utf-8"?>
<!--
    The status-bar small icon for every push this app receives.

    Android does NOT render this as artwork. It takes the alpha channel, throws
    the colours away, and fills the resulting silhouette with the notification
    accent colour. So a small icon has to be a solid white shape on a
    transparent background — which is why `@mipmap/launcher_icon` was the wrong
    resource for the job: a full-colour launcher icon is opaque edge to edge, so
    its silhouette is the whole square and it renders as a plain grey-white
    block with no discernible shape.

    A vector drawable is safe here because this app's `minSdk` is 24. Below API
    24 a VectorDrawable passed to `setSmallIcon` could fail inside RemoteViews,
    which is why notification icons are traditionally shipped as PNG densities.

    Material's `notifications` glyph, 24dp, unchanged.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M12,22c1.1,0 2,-0.9 2,-2h-4c0,1.1 0.89,2 2,2zM18,16v-5c0,-3.07 -1.64,-5.64 -4.5,-6.32V4c0,-0.83 -0.67,-1.5 -1.5,-1.5s-1.5,0.67 -1.5,1.5v0.68C7.63,5.36 6,7.92 6,11v5l-2,2v1h16v-1l-2,-2z" />
