<?xml version="1.0" encoding="utf-8"?>
<!-- Release and profile network policy (docs/security/README.md §4).

     * No cleartext HTTP to any host. The release build also refuses an
       http:// API URL at startup (`AppConfig.validateApiUrl`); this closes the
       same door for plugins and WebViews that do not go through Dio.
     * System CAs only. A user-installed CA — the first step of intercepting
       this app's traffic with Burp or mitmproxy — is not trusted.

     Debug builds replace this file with `src/debug/res/xml/` so a LAN backend
     over http:// and a debugging proxy keep working. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
