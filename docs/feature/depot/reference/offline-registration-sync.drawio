        <mxCell id="n45" value="&lt;b&gt;Atomic claim&lt;/b&gt;&lt;br&gt;queued → sending&lt;br&gt;(only one drain can win)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="330" y="1460" width="280" height="70" as="geometry"/></mxCell>
