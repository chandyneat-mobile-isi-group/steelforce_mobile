        <mxCell id="n42" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="n39" target="n35"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n43" value="&lt;b&gt;Wait 2 s&lt;/b&gt; before this POST&lt;br&gt;(no wait for the first one)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="330" y="1370" width="280" height="60" as="geometry"/></mxCell>
