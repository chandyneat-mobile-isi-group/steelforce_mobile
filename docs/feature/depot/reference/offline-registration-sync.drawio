        <mxCell id="n47" value="POST /api/v1/mobile/depots/business-partner" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="330" y="1560" width="280" height="50" as="geometry"/></mxCell>
