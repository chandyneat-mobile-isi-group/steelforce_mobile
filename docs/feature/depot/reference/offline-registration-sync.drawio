        <mxCell id="n55" value="&lt;b&gt;Back to queue&lt;/b&gt; (offline)&lt;br&gt;nothing reached the server" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="260" y="1800" width="200" height="80" as="geometry"/></mxCell>
