<mxfile host="app.diagrams.net" type="device">
  <diagram id="depot-offline-sync" name="Depot offline sync">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="2050" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="n2" value="Depot registration: offline queue and ordered sync" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="700" height="36" as="geometry"/></mxCell>
        <mxCell id="n3" value="Several depots created offline are sent to SAP one at a time, oldest first, with a 2 s gap between them." style="text;html=1;fontSize=12;align=left;verticalAlign=middle;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="44" width="900" height="24" as="geometry"/></mxCell>
        <mxCell id="n4" value="Rep taps Submit on Add Depot&lt;br&gt;(offline or server unreachable)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="330" y="90" width="280" height="70" as="geometry"/></mxCell>
        <mxCell id="n5" value="&lt;b&gt;Save on the phone first&lt;/b&gt;&lt;br&gt;• copy photos to app storage&lt;br&gt;• insert row, status = &lt;i&gt;queued&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="330" y="190" width="280" height="80" as="geometry"/></mxCell>
        <mxCell id="n6" value="depot_registration_queue&lt;br&gt;(encrypted Drift DB)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" vertex="1" parent="1"><mxGeometry x="670" y="190" width="190" height="80" as="geometry"/></mxCell>
        <mxCell id="n7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;fontSize=11;dashed=1;endArrow=none;" edge="1" parent="1" source="n5" target="n6"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n8" value="Wake the sync engine&lt;br&gt;requestSync()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="330" y="300" width="280" height="50" as="geometry"/></mxCell>
        <mxCell id="n9" value="&lt;b&gt;Other things that start a send&lt;/b&gt;&lt;br&gt;• app launch (signed-in shell)&lt;br&gt;• back online (real reachability)&lt;br&gt;• app returns to foreground&lt;br&gt;• retry timer (30 s·2ⁿ, max 15 min)&lt;br&gt;• rep taps &lt;i&gt;Sync now&lt;/i&gt;&lt;br&gt;• background worker (workmanager)" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#f9f7ed;strokeColor=#36393d;align=left;spacingLeft=8;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="290" width="260" height="150" as="geometry"/></mxCell>
        <mxCell id="n10" value="&lt;b&gt;SyncEngine drain&lt;/b&gt;&lt;br&gt;bursts merged (1 s), never two at once" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="330" y="380" width="280" height="60" as="geometry"/></mxCell>
        <mxCell id="n11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="n4" target="n5"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="n5" target="n8"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="n8" target="n10"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="n9" target="n10"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n15" value="Online and&lt;br&gt;signed in?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="370" y="470" width="200" height="100" as="geometry"/></mxCell>
        <mxCell id="n16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="n10" target="n15"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n17" value="Do nothing now.&lt;br&gt;Wait for the next trigger" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=10;" vertex="1" parent="1"><mxGeometry x="670" y="495" width="200" height="50" as="geometry"/></mxCell>
        <mxCell id="n18" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="n15" target="n17"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n19" value="&lt;b&gt;Outbox.drain()&lt;/b&gt;&lt;br&gt;read queue &lt;b&gt;oldest first&lt;/b&gt;&lt;br&gt;(ORDER BY createdAt)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="330" y="600" width="280" height="70" as="geometry"/></mxCell>
        <mxCell id="n20" value="Yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="n15" target="n19"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n21" value="Next row?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="390" y="700" width="160" height="90" as="geometry"/></mxCell>
        <mxCell id="n22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="n19" target="n21"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n23" value="&lt;b&gt;Drain finished&lt;/b&gt;&lt;br&gt;work left → engine arms retry timer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="670" y="715" width="240" height="60" as="geometry"/></mxCell>
        <mxCell id="n24" value="No more" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="n21" target="n23"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n25" value="Row status?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="380" y="820" width="180" height="100" as="geometry"/></mxCell>
        <mxCell id="n26" value="Yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="n21" target="n25"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n27" value="&lt;b&gt;Needs review / Refused&lt;/b&gt;&lt;br&gt;skip: waits for the rep,&lt;br&gt;does &lt;u&gt;not&lt;/u&gt; hold the line" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1"><mxGeometry x="670" y="795" width="240" height="70" as="geometry"/></mxCell>
        <mxCell id="n28" value="&lt;b&gt;Photos pending&lt;/b&gt;&lt;br&gt;upload photos to the depot&lt;br&gt;(safe to repeat)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="670" y="880" width="240" height="70" as="geometry"/></mxCell>
        <mxCell id="n29" value="needsReview / rejected" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="n25" target="n27"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n30" value="photosPending" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="n25" target="n28"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n31" value="&lt;b&gt;Sending in another drain&lt;/b&gt;&lt;br&gt;(background worker)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;dashed=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="835" width="240" height="70" as="geometry"/></mxCell>
        <mxCell id="n32" value="sending" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="n25" target="n31"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n33" value="Is an earlier&lt;br&gt;depot still&lt;br&gt;waiting?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="370" y="950" width="200" height="110" as="geometry"/></mxCell>
        <mxCell id="n34" value="queued" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="n25" target="n33"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n35" value="&lt;b&gt;Hold all later POSTs&lt;/b&gt;&lt;br&gt;keeps SAP order = creation order&lt;br&gt;(photo uploads still continue)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;dashed=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="1080" width="260" height="80" as="geometry"/></mxCell>
        <mxCell id="n36" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="n31" target="n35"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n37" value="Due now?&lt;br&gt;(backoff time passed)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="370" y="1090" width="200" height="100" as="geometry"/></mxCell>
        <mxCell id="n38" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="n33" target="n37"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n39" value="Enough time for&lt;br&gt;2 s gap + 75 s request?&lt;br&gt;(background budget)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="355" y="1220" width="230" height="120" as="geometry"/></mxCell>
        <mxCell id="n40" value="Yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="n37" target="n39"><mxGeometry relative="1" as="geometry"/></mxCell>
