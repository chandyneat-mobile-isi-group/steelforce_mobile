        <mxCell id="n79" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="n27" target="n78"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n80" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="n28" target="n78"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n81" value="&lt;b&gt;Sync Center (rep)&lt;/b&gt;&lt;br&gt;• each waiting depot shows “Number 2 of 3 in line”&lt;br&gt;• reason + next try time on the row&lt;br&gt;• Retry / Fix / Discard for rows needing the rep&lt;br&gt;• Sync now: clears backoff, drains at once" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1"><mxGeometry x="930" y="1080" width="330" height="120" as="geometry"/></mxCell>
        <mxCell id="n82" value="&lt;b&gt;Why one at a time?&lt;/b&gt;&lt;br&gt;The business-partner POST has no idempotency key and writes to SAP synchronously. Sending in order with a gap keeps the gateway calm. A depot that has to wait holds the ones behind it, so SAP gets them in the order the rep created them. Any answer that might mean SAP already has the depot goes to the rep, never resent automatically." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#f9f7ed;strokeColor=#36393d;align=left;spacingLeft=8;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="930" y="1230" width="330" height="170" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
