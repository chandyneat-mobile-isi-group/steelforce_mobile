<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Apple Push Notification service environment.
	     `development` is correct for debug builds and for TestFlight; Xcode's
	     "Automatically manage signing" and the App Store submission pipeline
	     both rewrite this to `production` for a distribution build, so this
	     value is a floor rather than a pin.

	     Without this entitlement `registerForRemoteNotifications()` succeeds
	     and then never calls back with a token — the app looks correctly wired
	     and simply never receives a push. The inbox keeps syncing, which is
	     what makes this the single easiest push misconfiguration to ship. -->
	<key>aps-environment</key>
	<string>development</string>
	<!-- App Attest, used by Firebase App Check's
	     `AppleAppAttestWithDeviceCheckFallbackProvider` in release builds.
	     Without this entitlement App Attest cannot run and every iOS device
	     drops to the weaker DeviceCheck. `production` because debug builds use
	     the App Check debug provider and never reach App Attest.

	     Automatic signing registers the capability on the App ID on the next
	     build. A manually managed provisioning profile must be regenerated
	     with "App Attest" enabled, or signing fails (docs/security/README.md §6). -->
	<key>com.apple.developer.devicecheck.appattest-environment</key>
	<string>production</string>
</dict>
</plist>
