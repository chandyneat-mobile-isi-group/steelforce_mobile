# Template for .env. Copy it and fill in real values:
#
#   cp .env.example .env
#   dart run build_runner build --delete-conflicting-outputs
#
# Every key below must be present. Envied reads them at build time and compiles
# them into lib/core/config/env.g.dart, so a missing or misspelled key fails
# code generation rather than failing at runtime.
#
# This file IS committed. Never put a real value in it.

# API roots — scheme and host only; no trailing slash or /api/v1.
# Debug/profile builds default to development; release builds default to
# production. Select explicitly with --dart-define=APP_ENV=development|production.
API_BASE_URL_DEV=https://your-development-host.example.com
API_BASE_URL_PRO=https://your-production-host.example.com

# Salt for the SQLCipher key derivation. Generate once per environment with:
#   python3 -c "import secrets,base64;print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode().rstrip('='))"
#
# Then KEEP IT STABLE. It is combined with the hardware-sealed device key, so
# changing it makes every existing encrypted database on every device
# unreadable — including any field captures not yet synced.
DB_SALT=

# Google Maps key for the native iOS layer. Consumed by
# `dart run tool/generate_ios_env.dart`, which writes ios/Flutter/Env.xcconfig.
GOOGLE_MAPS_IOS_KEY=
GOOGLE_MAPS_ANDROID_KEY=
